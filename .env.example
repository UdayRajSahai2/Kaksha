# Copy to .env (gitignored) and fill in. Never commit .env.

# PostgreSQL 18, local service postgresql-x64-18
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kaksha
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kaksha_test

# Optional: appended to the ingestion User-Agent so data providers can reach you (e.g. an email).
# Left empty, the User-Agent is generic.
KAKSHA_CONTACT=

# Space-Track (local-only features: history backfill, CDMs). Leave empty to skip them.
SPACETRACK_USER=
SPACETRACK_PASSWORD=
